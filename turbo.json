{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "LOG_LEVEL",
    "OTEL_ENABLED",
    "NODE_ENV",
    "APP_URL",
    "SESSION_SECRET",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "GITHUB_APP_ID",
    "GITHUB_APP_SLUG",
    "GITHUB_APP_PRIVATE_KEY",
    "GITHUB_WEBHOOK_SECRET",
    "GITHUB_DELIVERY_MODE",
    "SCM_DELIVERY_MODE",
    "GITLAB_BASE_URL",
    "GITLAB_CLIENT_ID",
    "GITLAB_CLIENT_SECRET",
    "GITLAB_WEBHOOK_SECRET",
    "SIGNAL_WEBHOOK_SECRET",
    "CREDENTIALS_ENCRYPTION_KEY",
    "LLM_API_KEY",
    "LLM_BASE_URL",
    "LLM_MODEL",
    "LLM_FALLBACK_API_KEY",
    "LLM_FALLBACK_BASE_URL",
    "LLM_FALLBACK_MODEL",
    "CURSOR_API_KEY",
    "CURSOR_MODEL",
    "ANTHROPIC_API_KEY",
    "CLAUDE_CODE_API_KEY",
    "CLAUDE_CODE_MODEL",
    "ANTHROPIC_MODEL",
    "CONTENDER_HARNESS",
    "OPENAI_API_KEY",
    "NEXT_PUBLIC_GA_MEASUREMENT_ID",
    "PILOT_INVITE_REQUIRED",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "STRIPE_PRICE_STARTER",
    "STRIPE_PRICE_PRO",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY"
  ],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
