# Hosted Coppergate (defaults match production)
BASE_URL=https://www.coppergate.ai

# Set after login, or paste a project URL from the app:
# CG_PROJECT_URL=https://www.coppergate.ai/workspaces/<ws>/projects/<project>
CG_PROJECT_URL=

# Optional overrides if you prefer IDs instead of a full URL
CG_WORKSPACE_ID=
CG_PROJECT_ID=

# GitHub verification (open PRs on the dogfood / target repo)
GITHUB_REPO=kprompt/kprompt-website
# Optional — without token, public PR list still works for public repos
GITHUB_TOKEN=

# How many recent closed/merged PRs to include in the report
GITHUB_PR_LIMIT=15
