# Coppergate web — self-host / production (Next.js standalone)
FROM node:22-bookworm-slim AS base
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages ./packages
COPY apps/web ./apps/web
RUN pnpm install --frozen-lockfile --filter @coppergate/web...

FROM deps AS build
ENV NEXT_TELEMETRY_DISABLED=1
# Placeholder DATABASE_URL so next build can evaluate env-dependent modules.
ENV DATABASE_URL=postgresql://coppergate:coppergate@127.0.0.1:5432/coppergate
ENV APP_URL=http://localhost:3000
RUN pnpm --filter @coppergate/web... build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
