# Self-host environment — copy to .env.selfhost and fill in.
# Docs: docs/SELF_HOST.md

# Public origin (no trailing slash). Example for Trendyol:
# APP_URL=https://coppergate.trendyol.com
APP_URL=https://coppergate.example.com

# Postgres password used by docker-compose.selfhost.yml
POSTGRES_PASSWORD=change-me-strong-password

# Host port for the web UI (maps to container 3000)
WEB_PORT=3000

NODE_ENV=production
LOG_LEVEL=info

# Required secrets (generate strong random values)
SESSION_SECRET=replace-with-at-least-32-characters-long!!
# 32-byte AES-GCM key as 64 hex chars:
#   openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- GitHub (optional if you only use GitLab) ---
# OAuth App → callback: {APP_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub App → callback/setup: {APP_URL}/api/integrations/github/callback
# Webhook: {APP_URL}/api/integrations/github/webhook
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Real PR delivery (worker):
GITHUB_DELIVERY_MODE=http

# --- GitLab (optional if you only use GitHub) ---
# Self-managed example: https://gitlab.trendyol.com
# SaaS: https://gitlab.com
GITLAB_BASE_URL=https://gitlab.com
# OAuth Application → redirect: {APP_URL}/api/auth/gitlab/callback
# Scopes: read_user, api
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# Webhook secret for project/group hooks → {APP_URL}/api/integrations/gitlab/webhook
GITLAB_WEBHOOK_SECRET=
# SCM delivery: fake | http (applies to GitHub PR and GitLab MR)
SCM_DELIVERY_MODE=http

# Optional coding agent (else FakeCodingAgent / workspace BYOK)
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini

# Invite gate (recommended true for public self-host)
PILOT_INVITE_REQUIRED=false

# Leave unset to disable GA on self-host
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
