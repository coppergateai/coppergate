{
  "name": "@coppergate/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-force-exit $(find src -name '*.test.ts')"
  },
  "dependencies": {
    "@coppergate/agents": "workspace:*",
    "@coppergate/config": "workspace:*",
    "@coppergate/db": "workspace:*",
    "@coppergate/github": "workspace:*",
    "@coppergate/gitlab": "workspace:*",
    "@coppergate/sandbox": "workspace:*",
    "@coppergate/scm": "workspace:*",
    "@coppergate/telemetry": "workspace:*"
  },
  "devDependencies": {
    "@coppergate/eslint-config": "workspace:*",
    "@coppergate/typescript-config": "workspace:*",
    "@types/node": "^22.15.21",
    "drizzle-orm": "^0.43.1",
    "eslint": "^9.27.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
