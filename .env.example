DATABASE_URL=postgresql://coppergate:coppergate@localhost:5433/coppergate
REDIS_URL=redis://localhost:6379
NODE_ENV=development
LOG_LEVEL=info
OTEL_ENABLED=false
APP_URL=http://localhost:3000
# Production: https://www.coppergate.ai (no trailing slash)
# Optional Google Search Console HTML-tag verification token
# GOOGLE_SITE_VERIFICATION=
# Min 32 chars. Optional in dev (a built-in default is used); required in production.
SESSION_SECRET=dev-only-coppergate-session-secret!!
# 32-byte AES-GCM key as 64 hex chars (dev default is fine locally)
CREDENTIALS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# GitHub OAuth App (identity scopes only: read:user, user:email)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub App (repo access via installation — no user `repo` scope)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM with literal \n escapes OK
GITHUB_APP_PRIVATE_KEY=
# GitHub App webhook HMAC secret
GITHUB_WEBHOOK_SECRET=
# Worker PR delivery: fake (default) | http (real App — staging TASK033)
GITHUB_DELIVERY_MODE=fake
# Unified SCM delivery (GitHub PR + GitLab MR). When set, overrides GITHUB_DELIVERY_MODE.
# SCM_DELIVERY_MODE=fake
# Worker sandbox: local (default LocalSandboxManager) | off
SANDBOX_MODE=local
# ContenderHarness override: openhands | native_fake | native_openai | …
# CONTENDER_HARNESS=openhands
# GitLab (optional — gitlab.com or self-managed)
GITLAB_BASE_URL=https://gitlab.com
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# GITLAB_WEBHOOK_SECRET=
# When true, workspace create requires a pilot invite code (TASK035)
PILOT_INVITE_REQUIRED=false
# Hosted billing (optional — Settings → Billing; webhook POST /api/billing/webhook)
# Required together for Checkout: secret + webhook + both price_… IDs + APP_URL
# See docs/STRIPE_PRODUCTION.md — Starter $99 / Pro $199 recurring Prices (not prod_…)
# STRIPE_SECRET_KEY=sk_test_…   # or sk_live_…
# STRIPE_WEBHOOK_SECRET=whsec_…
# STRIPE_PRICE_STARTER=price_…
# STRIPE_PRICE_PRO=price_…
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_…  # optional; Checkout is server redirect
# Validate: pnpm ops:stripe-env
# Optional OpenAI-compatible coding agent + brief/plan LLM (absent → FakeCodingAgent / deterministic drafts)
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
# Optional override for Google Analytics (defaults to G-R7MX20G0DF in code)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-R7MX20G0DF
