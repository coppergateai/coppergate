DATABASE_URL=postgresql://coppergate:coppergate@localhost:5433/coppergate
REDIS_URL=redis://localhost:6379
NODE_ENV=development
LOG_LEVEL=info
OTEL_ENABLED=false
APP_URL=http://localhost:3000
# Min 32 chars. Optional in dev (a built-in default is used); required in production.
SESSION_SECRET=dev-only-coppergate-session-secret!!
# 32-byte AES-GCM key as 64 hex chars (dev default is fine locally)
CREDENTIALS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# GitHub OAuth App (identity scopes only: read:user, user:email)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub App (repo access via installation — no user `repo` scope)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM with literal \n escapes OK
GITHUB_APP_PRIVATE_KEY=
