    "test": "node --import tsx --test $(find src -name '*.test.ts')",
    "prepare": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.0",
    "@coppergate/mcp-client": "workspace:^",
    "@coppergate/sandbox": "workspace:*",
    "@cursor/sdk": "^1.0.40"
  },
  "devDependencies": {
    "@coppergate/eslint-config": "workspace:*",
    "@coppergate/typescript-config": "workspace:*",
    "@types/node": "^22.15.21",
    "eslint": "^9.27.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
