{
  "name": "@coppergate/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test $(find src -name '*.test.ts')",
    "generate": "drizzle-kit generate",

    "migrate": "tsx src/migrate.ts",
    "migrate:down": "tsx src/migrate-down.ts",
    "prepare": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@coppergate/sandbox": "workspace:*",
    "drizzle-orm": "^0.43.1",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@coppergate/eslint-config": "workspace:*",
    "@coppergate/typescript-config": "workspace:*",
    "@types/node": "^22.15.21",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.27.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
